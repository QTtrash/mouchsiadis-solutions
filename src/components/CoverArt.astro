---
// Per-record pixel vignette (docs/visual-design.md, "Art direction").
// `record` picks project art by slug; otherwise the content `slug` (cover key)
// picks a category cover, falling back to the generic chip.
import PixelArt from "./PixelArt.astro";
import { artFor } from "../lib/sprites";

interface Props {
  slug: string;
  record?: string;
}

const { slug, record } = Astro.props;
---

<PixelArt grid={artFor(record, slug)} class="cover-art" />
