---
// The Simple view of a set of records, laid out as a datasheet index: a
// running number, the record's PixelLab illustration, title, outcome and
// stack, and a status column. Screenshots stay in the case files. The
// terminal view shows the card hand instead; both link to the same case files.
import CardArt from "./CardArt.astro";
import { cardSummary, casePath, localize, type CaseRecord } from "../lib/cards";
import { caseCopy, sheetCopy, type Locale } from "../lib/i18n";

interface Props {
  records: CaseRecord[];
  locale: Locale;
}

const { records, locale } = Astro.props;
const copy = caseCopy[locale];
const sheet = sheetCopy[locale];
const number = (index: number) => String(index + 1).padStart(2, "0");
---

<div class="work-sheet" data-simple-only>
  <p class="work-sheet__head" aria-hidden="true">
    <span>{sheet.no}</span>
    <span>{sheet.system}</span>
    <span>{sheet.status}</span>
  </p>
  <ul class="work-rows" role="list">
    {
      records.map(({ entry, suit }, index) => (
        <li class="work-row" data-suit={suit}>
          <a class="work-row__link" href={casePath(locale, entry.slug)}>
            <span class="work-row__no" aria-hidden="true">{number(index)}</span>
            <span class="work-row__media" aria-hidden="true">
              <CardArt slug={entry.slug} cover={entry.cover} glint />
            </span>
            <span class="work-row__text">
              <strong class="work-row__title">{entry.title}</strong>
              <span class="work-row__eyebrow">{localize(entry.eyebrow, locale)}</span>
              <span class="work-row__summary">{cardSummary(entry, locale)}</span>
              <span class="work-row__stack">{entry.stack.slice(0, 4).join(" · ")}</span>
            </span>
            <span class="work-row__status">
              {entry.live && (
                <span class="work-row__live">
                  <span class="work-row__led live-ping" style={`--ping-delay: ${(index % 5) * 0.64}s`} aria-hidden="true" />
                  {sheet.live}
                </span>
              )}
            </span>
            <span class="work-row__cta">
              <span class="visually-hidden">{copy.open}</span>
              <span aria-hidden="true">→</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</div>
