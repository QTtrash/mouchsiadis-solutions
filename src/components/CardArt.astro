---
// A case record's PixelLab illustration (src/lib/art.ts), with an optional
// hover glint sprite. Records without drawn art fall back to the build-time
// SVG vignette (CoverArt), so experience entries and new records still render.
import CoverArt from "./CoverArt.astro";
import { CARD_ART, VFX, cardArt, cardGlint, experienceArt } from "../lib/art";

interface Props {
  slug: string;
  cover: string;
  class?: string;
  eager?: boolean;
  glint?: boolean;
  /** Which art set to look in: case-record cards or experience roles. */
  kind?: "card" | "experience";
}

const { slug, cover, class: className, eager = false, glint = false, kind = "card" } = Astro.props;
const src = kind === "experience" ? experienceArt(slug) : cardArt(slug);
---

{
  src ? (
    <span class:list={["card-art", className]}>
      <img
        class="card-art__img"
        src={src}
        alt=""
        width={CARD_ART.width}
        height={CARD_ART.height}
        loading={eager ? "eager" : "lazy"}
        decoding="async"
        draggable="false"
      />
      {glint && (
        <span class="vfx-glint" aria-hidden="true">
          <img
            src={cardGlint}
            alt=""
            width={VFX.cardGlint.width * VFX.cardGlint.frames}
            height={VFX.cardGlint.height}
            loading="lazy"
            decoding="async"
          />
        </span>
      )}
    </span>
  ) : (
    <CoverArt slug={cover} record={slug} />
  )
}
