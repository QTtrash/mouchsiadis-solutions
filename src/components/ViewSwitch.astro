---
// The deliberately out-of-place switch: a rusty cartoon breaker lever bolted to
// the clean header. Pulling it boots the MS-86 terminal view; pulling it again
// returns to the Simple view. It is a real switch (role="switch") with a stable
// name, and its state is shown by the lever position and the lamp, not colour
// alone. Behaviour lives in Header.astro; the pre-paint script in BaseHead sets
// html[data-view] before first paint.
import { viewCopy, type Locale } from "../lib/i18n";
import { VFX, leverSparks } from "../lib/art";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = viewCopy[locale];
---

<button
  class="view-switch"
  type="button"
  role="switch"
  aria-checked="false"
  aria-label={copy.switchName}
  title={copy.hint}
  data-view-switch
>
  <svg class="view-switch__art" viewBox="0 0 64 56" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="vs-rust" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#9a5526" />
        <stop offset=".45" stop-color="#6b3214" />
        <stop offset=".7" stop-color="#a8622b" />
        <stop offset="1" stop-color="#43200c" />
      </linearGradient>
      <linearGradient id="vs-steel" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#5b6467" />
        <stop offset=".5" stop-color="#c9d0d2" />
        <stop offset="1" stop-color="#4a5254" />
      </linearGradient>
      <pattern id="vs-hazard" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect width="7" height="7" fill="#17120c" />
        <rect width="3.5" height="7" fill="#e9b52c" />
      </pattern>
      <filter id="vs-grit" x="0" y="0" width="1" height="1">
        <feTurbulence type="fractalNoise" baseFrequency=".85" numOctaves="2" seed="7" result="n" />
        <feColorMatrix in="n" values="0 0 0 0 .22 0 0 0 0 .09 0 0 0 0 .03 0 0 0 -2.4 1.45" result="spots" />
        <feComposite in="spots" in2="SourceGraphic" operator="atop" result="rust" />
        <feMerge><feMergeNode in="SourceGraphic" /><feMergeNode in="rust" /></feMerge>
      </filter>
    </defs>
    <g class="view-switch__plate">
      <rect x="5" y="15" width="54" height="36" rx="6" fill="url(#vs-rust)" filter="url(#vs-grit)" stroke="#1d0d05" stroke-width="2.2" />
      <path d="M7 41h50v6a4 4 0 0 1-4 4H11a4 4 0 0 1-4-4z" fill="url(#vs-hazard)" />
      <path d="M38 41h9l-3 4-5-1z" fill="#6b3214" />
      <path d="M7 41h50" stroke="#1d0d05" stroke-width="1.6" />
      <rect x="27.5" y="20" width="9" height="20" rx="3.5" fill="#1a0b04" />
      <g fill="url(#vs-steel)" stroke="#1d0d05" stroke-width="1.2">
        <circle cx="11" cy="21" r="2.4" />
        <circle cx="53" cy="21" r="2.4" />
      </g>
      <circle class="view-switch__lamp" cx="47" cy="29" r="3.4" stroke="#1d0d05" stroke-width="1.4" />
    </g>
    <g class="view-switch__lever">
      <rect x="30" y="6" width="4" height="34" rx="2" fill="url(#vs-steel)" stroke="#1d0d05" stroke-width="1.4" />
      <circle cx="32" cy="7" r="6.4" fill="#c2361f" stroke="#1d0d05" stroke-width="2" />
      <circle cx="29.8" cy="4.8" r="1.9" fill="#ffb59d" />
    </g>
  </svg>
  <span class="view-switch__vfx" aria-hidden="true">
    <img
      src={leverSparks}
      alt=""
      width={VFX.leverSparks.width * VFX.leverSparks.frames}
      height={VFX.leverSparks.height}
      decoding="async"
    />
  </span>
  <span class="view-switch__label" aria-hidden="true">
    <span class="view-switch__plate-text">{copy.plate}</span>
    <span class="view-switch__tag">{copy.tag}</span>
  </span>
</button>
