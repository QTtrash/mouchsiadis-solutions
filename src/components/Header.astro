---
import {
  LOCALES,
  localeIntlCodes,
  localeLabels,
  navigationCopy,
  type Locale,
} from "../lib/i18n";
import { buildLocalePath } from "../lib/blog";
import "@awesome.me/webawesome/dist/styles/themes/default.css";

interface Props {
  locale: Locale;
  active?: "home" | "blog" | "tooling";
  localePathSuffix?: string;
}

const { locale, active = "home", localePathSuffix = "" } = Astro.props;
const nav = navigationCopy[locale];
const home = buildLocalePath(locale);
const contactHref = `${home}#contact`;
const cvHref = "/cv/Suren_Mouchsiadis_CV.pdf";
const links = [
  { key: "work", label: nav.work, href: `${home}#software-work` },
  { key: "games", label: nav.games, href: `${home}#game-dev` },
  { key: "tooling", label: nav.tooling, href: buildLocalePath(locale, "/tooling") },
  { key: "experience", label: nav.experience, href: `${home}#experience` },
  { key: "notes", label: nav.notes, href: buildLocalePath(locale, "/blog") },
];
const drawerLinks = [...links, { key: "contact", label: nav.contact, href: contactHref }];
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href={home} aria-label="Mouchsiadis Solutions" data-astro-prefetch>
      <span class="site-header__prefix">
        <span class="site-header__led" aria-hidden="true"></span>
        suren@ms-86:~$
      </span>
      <span>Mouchsiadis Solutions</span>
    </a>

    <nav class="site-header__nav" aria-label={nav.primaryLabel}>
      {
        links.map((link) => (
          <a
            class:list={[
              link.key === "tooling" && active === "tooling" && "is-active",
              link.key === "notes" && active === "blog" && "is-active",
            ]}
            href={link.href}
            data-astro-prefetch
            aria-current={
              (link.key === "tooling" && active === "tooling") ||
              (link.key === "notes" && active === "blog")
                ? "page"
                : undefined
            }
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="site-header__controls">
      <nav class="locale-switcher" aria-label={nav.languagesLabel}>
        {
          LOCALES.map((entry) => (
            <a
              class:list={[entry === locale && "is-active"]}
              href={buildLocalePath(entry, localePathSuffix)}
              lang={localeIntlCodes[entry]}
              hreflang={localeIntlCodes[entry]}
              aria-current={entry === locale ? "page" : undefined}
              aria-label={localeIntlCodes[entry]}
            >
              {localeLabels[entry]}
            </a>
          ))
        }
      </nav>
      <a class="site-header__hire" href={contactHref} data-astro-prefetch>{nav.contact}</a>
      <button class="site-header__options" type="button" data-drawer-open aria-haspopup="dialog" aria-expanded="false">
        <span class="site-header__options-desktop">{nav.options}</span>
        <span class="site-header__options-mobile">{nav.menu}</span>
      </button>
    </div>
  </div>

  <wa-drawer
    class="navigation-drawer"
    label={nav.drawerLabel}
    placement="end"
    light-dismiss
    data-navigation-drawer
  >
    <nav class="navigation-drawer__links" aria-label={nav.primaryLabel}>
      {
        drawerLinks.map((link, index) => (
          <a href={link.href} data-drawer-link data-astro-prefetch>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{link.label}</strong>
          </a>
        ))
      }
      <a href={cvHref} target="_blank" rel="noopener noreferrer">
        <span>{String(drawerLinks.length + 1).padStart(2, "0")}</span>
        <strong>{nav.cv} (PDF)</strong>
      </a>
    </nav>

    <section class="navigation-drawer__languages" aria-labelledby="drawer-language-title">
      <h2 id="drawer-language-title">{nav.languagesLabel}</h2>
      <div>
        {
          LOCALES.map((entry) => (
            <a
              class:list={[entry === locale && "is-active"]}
              href={buildLocalePath(entry, localePathSuffix)}
              lang={localeIntlCodes[entry]}
              hreflang={localeIntlCodes[entry]}
            >
              {localeLabels[entry]}
            </a>
          ))
        }
      </div>
    </section>

    <section class="navigation-drawer__preferences" aria-labelledby="drawer-options-title">
      <h2 id="drawer-options-title">{nav.preferences}</h2>
      <button type="button" data-sound-preference aria-pressed="false">
        <span>{nav.sound}</span><b>OFF</b>
      </button>
      <button
        type="button"
        data-effects-preference
        data-system-label={nav.effectsSystem}
        data-reduced-label={nav.effectsReduced}
        aria-pressed="false"
      >
        <span>{nav.effects}</span><b data-effects-label>{nav.effectsSystem}</b>
      </button>
    </section>
  </wa-drawer>
</header>

<script>
  const drawer = document.querySelector<HTMLElement & { open: boolean }>(
    "[data-navigation-drawer]",
  );
  const openButton = document.querySelector<HTMLButtonElement>("[data-drawer-open]");

  let drawerModule: Promise<unknown> | undefined;
  openButton?.addEventListener("click", async () => {
    drawerModule ??= import("@awesome.me/webawesome/dist/components/drawer/drawer.js");
    try {
      await drawerModule;
      if (drawer) drawer.open = true;
    } catch {
      // Keep real navigation available if the optional drawer cannot download.
      drawerModule = undefined;
      document.documentElement.classList.add("drawer-unavailable");
    }
  });
  drawer?.addEventListener("wa-show", () => openButton?.setAttribute("aria-expanded", "true"));
  drawer?.addEventListener("wa-hide", () => openButton?.setAttribute("aria-expanded", "false"));
  drawer?.querySelectorAll<HTMLAnchorElement>("[data-drawer-link]").forEach((link) => {
    link.addEventListener("click", () => {
      drawer.open = false;
    });
  });

  const SOUND_KEY = "terminalSound";
  const EFFECTS_KEY = "interfaceEffects";
  const soundButton = drawer?.querySelector<HTMLButtonElement>("[data-sound-preference]");
  const effectsButton = drawer?.querySelector<HTMLButtonElement>("[data-effects-preference]");
  const effectsLabel = effectsButton?.querySelector<HTMLElement>("[data-effects-label]");

  const readPreference = (key: string): string | null => {
    try { return localStorage.getItem(key); } catch { return null; }
  };
  const writePreference = (key: string, value: string): void => {
    try { localStorage.setItem(key, value); } catch { /* Keep the current page usable without storage. */ }
  };
  let soundOn = readPreference(SOUND_KEY) === "on";
  let reduced = document.documentElement.dataset.effects === "reduced";
  const syncPreferences = () => {
    soundButton?.setAttribute("aria-pressed", String(soundOn));
    const soundValue = soundButton?.querySelector("b");
    if (soundValue) soundValue.textContent = soundOn ? "ON" : "OFF";
    effectsButton?.setAttribute("aria-pressed", String(reduced));
    if (effectsLabel && effectsButton) {
      effectsLabel.textContent = reduced
        ? effectsButton.dataset.reducedLabel || "REDUCED"
        : effectsButton.dataset.systemLabel || "SYSTEM";
    }
  };

  soundButton?.addEventListener("click", () => {
    soundOn = !soundOn;
    writePreference(SOUND_KEY, soundOn ? "on" : "off");
    window.dispatchEvent(new CustomEvent("terminal-sound-change", { detail: soundOn }));
    syncPreferences();
  });
  effectsButton?.addEventListener("click", () => {
    reduced = !reduced;
    writePreference(EFFECTS_KEY, reduced ? "reduced" : "system");
    document.documentElement.dataset.effects = reduced ? "reduced" : "system";
    syncPreferences();
  });
  syncPreferences();
</script>
