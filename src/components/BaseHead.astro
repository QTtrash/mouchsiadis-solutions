---
import { LOCALES, localeIntlCodes, localeSeo, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  alternates?: Record<Locale, string>;
  noindex?: boolean;
}

const {
  locale,
  title = localeSeo[locale].title,
  description = localeSeo[locale].description,
  image = "/images/profile-pic.webp",
  article = false,
  alternates,
  noindex = false,
} = Astro.props;

const fullTitle =
  title === localeSeo[locale].title
    ? title
    : `${title} | ${localeSeo[locale].title}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<script is:inline>
  // Pre-paint preferences. View: ?view= (shared links) → stored choice →
  // the Simple view. Effects follow the OS unless explicitly reduced.
  (function () {
    var root = document.documentElement;
    root.classList.add("js");
    var view = "simple";
    var effects = "system";
    try {
      var asked = new URLSearchParams(location.search).get("view");
      var stored = localStorage.getItem("interfaceView");
      if (asked === "terminal" || asked === "simple") {
        view = asked;
        localStorage.setItem("interfaceView", asked);
      } else if (stored === "terminal") {
        view = "terminal";
      }
      if (localStorage.getItem("interfaceEffects") === "reduced") effects = "reduced";
    } catch (error) {
      var match = /[?&]view=(terminal|simple)\b/.exec(location.search);
      if (match) view = match[1];
    }
    root.dataset.view = view;
    root.dataset.effects = effects;
  })();
</script>
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="canonical" href={canonicalURL} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content="Suren Mouchsiadis" />
{noindex && <meta name="robots" content="noindex" />}

{
  alternates &&
    LOCALES.map((entry) => (
      <link
        rel="alternate"
        hreflang={localeIntlCodes[entry]}
        href={new URL(alternates[entry], Astro.site)}
      />
    ))
}
{
  alternates && (
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(alternates.en, Astro.site)}
    />
  )
}

<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={new URL(image, Astro.site)} />
<meta property="og:image:alt" content={fullTitle} />
<meta
  property="og:locale"
  content={localeIntlCodes[locale].replace("-", "_")}
/>

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image, Astro.site)} />
