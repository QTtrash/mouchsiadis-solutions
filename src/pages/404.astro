---
// One static 404 serves every locale. English renders by default; a tiny inline
// script shows the copy that matches the requested path's locale prefix.
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildLocaleAlternates, buildLocalePath } from "../lib/blog";
import { EMAIL, mailto } from "../lib/contact";
import {
  LOCALES,
  localeIntlCodes,
  localeLabels,
  localeSeo,
} from "../lib/i18n";
---

<BaseLayout
  locale="en"
  title={localeSeo.en.labels.notFoundTitle}
  alternates={buildLocaleAlternates()}
  noindex={true}
>
  <section class="section not-found-shell">
    <p class="section-heading__kicker">404 // SIGNAL LOST</p>
    {
      LOCALES.map((locale) => {
        const labels = localeSeo[locale].labels;
        return (
          <div
            class="not-found"
            data-not-found={locale}
            lang={localeIntlCodes[locale]}
            hidden={locale !== "en"}
          >
            <h1>{labels.notFoundTitle}</h1>
            <p class="section-heading__body">{labels.notFoundBody}</p>
            <div class="hero-panel__actions">
              <a class="button button--primary" href={buildLocalePath(locale)}>
                {labels.returnHome}
              </a>
            </div>
            <p class="not-found__contact">
              {labels.articleContact}{" "}
              <a href={mailto(labels.mailSubject)}>{EMAIL}</a>
            </p>
          </div>
        );
      })
    }
    <nav class="not-found__languages" aria-label={localeSeo.en.labels.notFoundTitle}>
      {
        LOCALES.map((locale) => (
          <a
            href={buildLocalePath(locale)}
            lang={localeIntlCodes[locale]}
            hreflang={localeIntlCodes[locale]}
          >
            {localeLabels[locale]}
          </a>
        ))
      }
    </nav>
  </section>
  <script is:inline>
    (() => {
      const match = location.pathname.match(/^\/(ru|de|ge)(\/|$)/);
      if (!match) return;
      document.querySelectorAll("[data-not-found]").forEach((block) => {
        block.hidden = block.dataset.notFound !== match[1];
      });
    })();
  </script>
</BaseLayout>
