---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  buildLocaleAlternates,
  buildLocalePath,
  formatDate,
  getPostLanguage,
  getPostLanguageLabel,
  getPostSlug,
  sortPosts,
} from "../../../lib/blog";
import { LOCALES, isLocale, localeSeo, type Locale } from "../../../lib/i18n";

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const localeParam = Astro.params.locale;

if (!localeParam || !isLocale(localeParam)) {
  throw new Error(`Unsupported locale: ${localeParam}`);
}

const locale: Locale = localeParam;
const copy = localeSeo[locale];
const posts = sortPosts(await getCollection("blog"));
const alternates = buildLocaleAlternates("/blog");
const yearGroups = Array.from(
  posts.reduce((groups, post) => {
    const year = post.data.date.getUTCFullYear();
    const entries = groups.get(year) ?? [];
    entries.push(post);
    groups.set(year, entries);
    return groups;
  }, new Map<number, typeof posts>()),
);
---

<BaseLayout
  locale={locale}
  title={copy.sections.blog}
  description={copy.sectionBodies.blog}
  active="blog"
  alternates={alternates}
  localePathSuffix="/blog"
>
  <section class="section">
    <div class="section-heading">
      <p class="section-heading__kicker">{copy.sectionKickers.blog}</p>
      <h1>{copy.sections.blog}</h1>
      <p class="section-heading__body">{copy.sectionBodies.blog}</p>
    </div>

    <p class="blog-index__count">{String(posts.length).padStart(2, "0")} / ARCHIVE RECORDS</p>
    <div class="blog-index blog-index--grouped">
      {
        yearGroups.map(([year, entries]) => (
          <section class="blog-year" aria-labelledby={`year-${year}`}>
            <h2 id={`year-${year}`}>{year}</h2>
            <div>
              {entries.map((post) => {
                const postLocale = getPostLanguage(post);
                return (
                  <article class="blog-index__item" lang={postLocale}>
                    <div class="blog-index__meta">
                      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, locale)}</time>
                      <span class="blog-index__language">
                        {getPostLanguageLabel(postLocale, locale)}
                      </span>
                    </div>
                    <h3>
                      <a href={buildLocalePath(postLocale, `/blog/${getPostSlug(post)}`)}>
                        {post.data.title}
                      </a>
                    </h3>
                    {post.data.description && <p>{post.data.description}</p>}
                  </article>
                );
              })}
            </div>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>
