---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArchiveEntry from "../../components/ArchiveEntry.astro";
import CardDeck from "../../components/CardDeck.astro";
import PixelArt from "../../components/PixelArt.astro";
import TerminalChassis from "../../components/TerminalChassis.astro";
import { avatarSprite } from "../../lib/avatar";
import { navSprites } from "../../lib/sprites";
import { experiences, proofPoints } from "../../lib/content";
import { casePath, gameRecords, localize, workRecords } from "../../lib/cards";
import {
  buildLocaleAlternates,
  buildLocalePath,
  sortPosts,
  formatDate,
  getPostLanguage,
  getPostSlug,
} from "../../lib/blog";
import {
  LOCALES,
  deckCopy,
  isLocale,
  localeLabels,
  localeSeo,
  navigationCopy,
  type Locale,
} from "../../lib/i18n";
import "../../assets/styles/deck.css";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const localeParam = Astro.params.locale;

if (!localeParam || !isLocale(localeParam)) {
  throw new Error(`Unsupported locale: ${localeParam}`);
}

const locale: Locale = localeParam;
const copy = localeSeo[locale];
const navigation = navigationCopy[locale];
const deck = deckCopy[locale];
const alternates = buildLocaleAlternates();
const localized = <T,>(record: { en: T } & Partial<Record<Locale, T>>) => localize(record, locale);
const recentPosts = sortPosts(await getCollection("blog")).slice(0, 3);
const cvHref = "/cv/Suren_Mouchsiadis_CV.pdf";
---

<BaseLayout locale={locale} alternates={alternates}>
  <section
    class="terminal-console section"
    data-terminal-console
    data-terminal-lang={localeLabels[locale]}
  >
    <TerminalChassis />
    <div class="terminal-status" aria-hidden="true">
      <span>Mouchsiadis // field terminal</span>
      <span>LANG {localeLabels[locale]}</span>
      <span>STATION MUC-01</span>
    </div>

    <div class="terminal-console__body">
      <nav class="terminal-side-nav" aria-label={navigation.primaryLabel}>
        <a
          class="is-active"
          href="#overview"
          data-terminal-tab
          aria-current="page"><PixelArt grid={navSprites.overview} class="terminal-side-nav__icon" />{copy.nav.overview}</a
        >
        <a href="#software-work" data-terminal-tab><PixelArt grid={navSprites.work} class="terminal-side-nav__icon" />{copy.nav.work}</a>
        <a href="#game-dev" data-terminal-tab><PixelArt grid={navSprites.games} class="terminal-side-nav__icon" />{copy.nav.games}</a>
        <a href="#experience" data-terminal-tab><PixelArt grid={navSprites.experience} class="terminal-side-nav__icon" />{copy.nav.experience}</a>
        <a class="tooling-portal-link" href={buildLocalePath(locale, "/tooling")}><PixelArt grid={navSprites.tooling} class="terminal-side-nav__icon" />{navigation.tooling} ↗</a>
        <a href="#blog" data-terminal-tab><PixelArt grid={navSprites.notes} class="terminal-side-nav__icon" />{copy.nav.blog}</a>
        <a href="#contact" data-terminal-tab><PixelArt grid={navSprites.contact} class="terminal-side-nav__icon" />{copy.nav.contact}</a>
      </nav>

      <div class="terminal-console__content">
        <section
          id="overview"
          class="hero-panel terminal-section is-active"
          data-terminal-panel="overview"
        >
          <div class="hero-panel__grid">
            <div class="hero-panel__copy">
              <p class="hero-panel__kicker">
                Suren Mouchsiadis / {localeLabels[locale]}
              </p>
              <h1>{copy.heroTitle}</h1>
              <p class="hero-panel__body">{copy.heroBody}</p>

              <div class="hero-panel__actions" data-fast-path>
                <a class="button button--primary" href="#contact" data-terminal-jump
                  >{copy.cta.contact}</a
                >
                <a
                  class="button"
                  href={cvHref}
                  target="_blank"
                  rel="noopener noreferrer">{copy.cta.cv}</a
                >
                <a class="button button--ghost" href="#software-work" data-terminal-jump
                  >{copy.cta.play}</a
                >
              </div>

              <div class="hero-panel__chips">
                <span>{copy.labels.basedIn}</span>
                <span>{copy.labels.studioMode}</span>
                <span>{copy.labels.availableFor}</span>
              </div>
            </div>

            <div class="hero-panel__signal">
              <div class="signal-card signal-card--primary">
                <button
                  class="signal-card__portrait avatar-card"
                  type="button"
                  data-avatar-flip
                  aria-pressed="false"
                >
                  <PixelArt grid={avatarSprite} class="avatar-card__pixel" />
                  <img
                    class="avatar-card__photo"
                    src="/images/profile-pic.webp"
                    alt=""
                    width="640"
                    height="640"
                    loading="lazy"
                  />
                  <span class="visually-hidden">{deck.avatarPhoto}</span>
                </button>
                <strong>{copy.labels.currentFocus}</strong>
                <p>{copy.labels.currentFocusBody}</p>
              </div>
              <section class="signal-card proof-card" aria-labelledby="proof-title">
                <h2 id="proof-title">{deck.evidenceTitle}</h2>
                <ul role="list">
                  {
                    proofPoints.map((point) => (
                      <li>
                        {point.target === "experience" ? (
                          <a href="#experience" data-terminal-jump>{localized(point.label)}</a>
                        ) : (
                          <a href={casePath(locale, point.target)}>{localized(point.label)}</a>
                        )}
                      </li>
                    ))
                  }
                </ul>
              </section>
            </div>
          </div>

          <aside
            class="open-source-milestone"
            aria-labelledby="open-source-title"
          >
            <img
              src="/images/raid-signal-open-source.webp"
              alt=""
              width="1280"
              height="640"
              loading="lazy"
            />
            <div>
              <p class="section-heading__kicker">
                {copy.labels.openSourceKicker}
              </p>
              <h2 id="open-source-title">{copy.labels.openSourceTitle}</h2>
              <p>{copy.labels.openSourceBody}</p>
            </div>
            <nav aria-label={copy.labels.openSourceTitle}>
              <a
                class="button"
                href="https://signal.mouchsiadis-solutions.com"
                target="_blank"
                rel="noopener noreferrer">{copy.labels.openSourceProduct}</a
              >
              <a
                class="button button--ghost"
                href="https://github.com/QTtrash/tarkov-map"
                target="_blank"
                rel="noopener noreferrer">{copy.labels.openSourceCode}</a
              >
            </nav>
          </aside>
        </section>

        <section
          id="software-work"
          class="section terminal-section"
          data-terminal-panel="software-work"
        >
          <div class="section-heading">
            <p class="section-heading__kicker">{copy.sectionKickers.work}</p>
            <h2>{copy.sections.work}</h2>
            <p class="section-heading__body">{copy.sectionBodies.work}</p>
          </div>

          <CardDeck records={workRecords} locale={locale} />
        </section>

        <section
          id="game-dev"
          class="section terminal-section"
          data-terminal-panel="game-dev"
        >
          <div class="section-heading">
            <p class="section-heading__kicker">{copy.sectionKickers.games}</p>
            <h2>{copy.sections.games}</h2>
            <p class="section-heading__body">{copy.sectionBodies.games}</p>
          </div>

          <CardDeck records={gameRecords} locale={locale} />
        </section>

        <section
          id="experience"
          class="section terminal-section"
          data-terminal-panel="experience"
        >
          <div class="section-heading">
            <p class="section-heading__kicker">
              {copy.sectionKickers.experience}
            </p>
            <h2>{copy.sections.experience}</h2>
            <p class="section-heading__body">{copy.sectionBodies.experience}</p>
          </div>

          <div class="archive-grid archive-grid--timeline">
            {
              experiences.map((entry) => (
                <ArchiveEntry
                  compact={true}
                  title={`${localized(entry.title)} / ${entry.company}`}
                  eyebrow={localized(entry.summary)}
                  summary={`${entry.range} / ${entry.location}`}
                  narrative={localized(entry.summary)}
                  details={localized(entry.details)}
                  stack={entry.stack}
                  meta={[entry.range, entry.location]}
                  cover={entry.cover}
                  toggleLabel={copy.labels.archiveOpen}
                  toggleCloseLabel={copy.labels.archiveClose}
                />
              ))
            }
          </div>
        </section>

        <section
          id="blog"
          class="section terminal-section"
          data-terminal-panel="blog"
        >
          <div class="section-heading">
            <p class="section-heading__kicker">{copy.sectionKickers.blog}</p>
            <h2>{copy.sections.blog}</h2>
            <p class="section-heading__body">{copy.labels.blogBody}</p>
          </div>

          {
            recentPosts.length > 0 && (
              <div class="blog-index blog-index--compact">
                {recentPosts.map((post) => (
                  <article class="blog-index__item">
                    <div class="blog-index__meta">
                      <span>{formatDate(post.data.date, locale)}</span>
                    </div>
                    <h3>
                      <a
                        href={buildLocalePath(
                          getPostLanguage(post),
                          `/blog/${getPostSlug(post)}`,
                        )}
                      >
                        {post.data.title}
                      </a>
                    </h3>
                    {post.data.description && <p>{post.data.description}</p>}
                  </article>
                ))}
              </div>
            )
          }

          <div class="blog-callout">
            <p>{copy.sectionBodies.blog}</p>
            <a class="button" href={buildLocalePath(locale, "/blog")}
              >{copy.cta.blog}</a
            >
          </div>
        </section>

        <section
          id="contact"
          class="section terminal-section"
          data-terminal-panel="contact"
        >
          <div class="section-heading">
            <p class="section-heading__kicker">{copy.sectionKickers.contact}</p>
            <h2>{copy.sections.contact}</h2>
            <p class="section-heading__body">{copy.sectionBodies.contact}</p>
          </div>

          <div class="contact-panel">
            <a href="mailto:suren@mouchsiadis-solutions.com"
              >suren@mouchsiadis-solutions.com</a
            >
            <a
              href="https://github.com/QTtrash"
              target="_blank"
              rel="noopener noreferrer">{copy.labels.githubLabel}</a
            >
            <a
              href="https://www.linkedin.com/in/surenmouchsiadis"
              target="_blank"
              rel="noopener noreferrer">{copy.labels.linkedinLabel}</a
            >
          </div>

          <div class="cv-panel" id="cv">
            <div class="cv-panel__copy">
              <p class="section-heading__kicker">{copy.sectionKickers.cv}</p>
              <p class="cv-panel__education">
                EDU REC / TUM / BS COMPUTER SCIENCE / DEC 2019
              </p>
              <p>{copy.labels.cvBody}</p>
              <div class="hero-panel__actions">
                <a
                  class="button"
                  href={cvHref}
                  target="_blank"
                  rel="noopener noreferrer">{copy.labels.cvOpen}</a
                >
                <a class="button button--ghost" href={cvHref} download
                  >{copy.labels.cvDownload}</a
                >
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
  </section>

  <script>
    import "../../scripts/terminal.ts";
    import "../../scripts/deck.ts";
  </script>
</BaseLayout>
