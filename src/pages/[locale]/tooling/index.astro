---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { toolProjects } from "../../../lib/content";
import { buildLocalePath, buildLocaleAlternates } from "../../../lib/blog";
import { LOCALES, isLocale, type Locale } from "../../../lib/i18n";
import "../../../assets/styles/tooling.css";

export function getStaticPaths() { return LOCALES.map((locale) => ({ params: { locale } })); }
const localeParam = Astro.params.locale;
if (!localeParam || !isLocale(localeParam)) throw new Error(`Unsupported locale: ${localeParam}`);
const locale: Locale = localeParam;
const localized = <T,>(record: { en: T } & Partial<Record<Locale, T>>) => record[locale] ?? record.en;
const copy = {
  en: { kicker: "INSTRUMENT VAULT / 05 ACTIVE SYSTEMS", title: "Working systems, given physical form.", body: "Enter a spatial index of independently designed tools for evidence, coordination, personal records, and document operations.", open: "OPEN INSTRUMENT", back: "RETURN TO FIELD TERMINAL", note: "Live systems · independently designed and operated", sound: "SND" },
  de: { kicker: "INSTRUMENTENTRESOR / 05 AKTIVE SYSTEME", title: "Arbeitende Systeme in physischer Form.", body: "Ein raeumlicher Index unabhaengig entwickelter Werkzeuge fuer Evidenz, Koordination, persoenliche Aufzeichnungen und Dokumentablaeufe.", open: "INSTRUMENT OEFFNEN", back: "ZUM FELDTERMINAL", note: "Live-Systeme · unabhaengig entwickelt und betrieben", sound: "TON" },
  ru: { kicker: "ХРАНИЛИЩЕ ИНСТРУМЕНТОВ / 05 СИСТЕМ", title: "Рабочие системы в физической форме.", body: "Пространственный индекс независимо созданных инструментов для анализа, координации, личных записей и документов.", open: "ОТКРЫТЬ ИНСТРУМЕНТ", back: "ВЕРНУТЬСЯ В ТЕРМИНАЛ", note: "Рабочие системы · независимо спроектированы и запущены", sound: "ЗВУК" },
  ge: { kicker: "ინსტრუმენტების საცავი / 05 აქტიური სისტემა", title: "მოქმედი სისტემები ფიზიკურ ფორმაში.", body: "დამოუკიდებლად შექმნილი ხელსაწყოების სივრცითი ინდექსი ანალიზის, კოორდინაციის, პირადი ჩანაწერებისა და დოკუმენტებისთვის.", open: "ინსტრუმენტის გახსნა", back: "ტერმინალში დაბრუნება", note: "მოქმედი სისტემები · დამოუკიდებლად შექმნილი და მართული", sound: "ხმა" },
}[locale];
---
<BaseLayout locale={locale} active="tooling" localePathSuffix="/tooling" bodyClass="tooling-page" title={`Tooling · Mouchsiadis Solutions`} description={copy.body} alternates={buildLocaleAlternates("/tooling")}>
  <section class="instrument-vault" data-instrument-vault>
    <div class="vault-stage" aria-hidden="true">
      <canvas></canvas>
      <div class="vault-fallback"><i></i><i></i><i></i><span>INSTRUMENT / 01</span></div>
      <div class="vault-reticle"><span></span><span></span><span></span><span></span></div>
      <div class="vault-readout"><span>VAULT / ACTIVE</span><b data-vault-number>01</b><i data-vault-name>GRINDLIKE</i></div>
    </div>

    <div class="vault-content">
      <header class="vault-hero">
        <div><a class="tooling-return" href={buildLocalePath(locale)}>← {copy.back}</a><p>{copy.kicker}</p><h1>{copy.title}</h1><span>{copy.body}</span></div>
        <button class="vault-sound" type="button" data-vault-sound aria-pressed="false">{copy.sound} OFF</button>
        <p class="vault-instruction">SCROLL TO INSPECT<br />FOCUS TO ACQUIRE</p>
      </header>

      <div class="instrument-index" aria-label="Public tools">
        {toolProjects.map((tool, index) => <article class:list={["instrument-entry", index === 0 && "is-active"]} data-vault-entry data-tool-index={index} data-instrument={tool.instrument}>
          <header><span>{String(index + 1).padStart(2, "0")}</span><i>{tool.instrument?.replaceAll("-", " / ").toUpperCase()}</i><b>ONLINE</b></header>
          <div class="instrument-entry__body"><p>{localized(tool.eyebrow)}</p><h2>{tool.title}</h2><span>{localized(tool.summary)}</span></div>
          <ul>{tool.stack.slice(0, 5).map((item) => <li>{item}</li>)}</ul>
          <a href={tool.link} target="_blank" rel="noopener noreferrer">{copy.open} <b>↗</b></a>
        </article>)}
      </div>
    </div>
  </section>
  <p class="tooling-note">{copy.note}</p>
  <script>void import("../../../scripts/tooling-field");</script>
</BaseLayout>
