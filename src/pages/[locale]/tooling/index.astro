---
// Tooling: the instrument atlas as one more panel of the field terminal.
// Same card deck, reader, and pixel art as the landing page; the side nav
// links back into the landing panels.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CardDeck from "../../../components/CardDeck.astro";
import PixelArt from "../../../components/PixelArt.astro";
import TerminalChassis from "../../../components/TerminalChassis.astro";
import { toolRecords } from "../../../lib/cards";
import { buildLocalePath, buildLocaleAlternates } from "../../../lib/blog";
import { navSprites } from "../../../lib/sprites";
import { LOCALES, isLocale, localeLabels, localeSeo, navigationCopy, toolingCopy, type Locale } from "../../../lib/i18n";
import "../../../assets/styles/deck.css";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const localeParam = Astro.params.locale;
if (!localeParam || !isLocale(localeParam)) throw new Error(`Unsupported locale: ${localeParam}`);
const locale: Locale = localeParam;
const copy = toolingCopy[locale];
const seo = localeSeo[locale];
const navigation = navigationCopy[locale];
const home = buildLocalePath(locale);
const kicker = copy.kicker.replace("{count}", String(toolRecords.length).padStart(2, "0"));
const tabs = [
  { key: "overview", href: `${home}#overview`, label: seo.nav.overview },
  { key: "work", href: `${home}#software-work`, label: seo.nav.work },
  { key: "games", href: `${home}#game-dev`, label: seo.nav.games },
  { key: "experience", href: `${home}#experience`, label: seo.nav.experience },
  { key: "tooling", href: buildLocalePath(locale, "/tooling"), label: navigation.tooling, current: true },
  { key: "notes", href: `${home}#blog`, label: seo.nav.blog },
  { key: "contact", href: `${home}#contact`, label: seo.nav.contact },
] as const;
---

<BaseLayout
  locale={locale}
  active="tooling"
  localePathSuffix="/tooling"
  title={navigation.tooling}
  description={copy.body}
  image="/images/raid-signal-open-source.webp"
  alternates={buildLocaleAlternates("/tooling")}
>
  <section class="terminal-console section tooling-console" data-terminal-lang={localeLabels[locale]}>
    <TerminalChassis />
    <div class="terminal-status" aria-hidden="true">
      <span>Mouchsiadis // field terminal</span>
      <span>LANG {localeLabels[locale]}</span>
      <span>STATION MUC-01</span>
    </div>

    <div class="terminal-console__body">
      <nav class="terminal-side-nav" aria-label={navigation.primaryLabel}>
        {
          tabs.map((tab) => (
            <a
              class:list={["current" in tab && "is-active"]}
              href={tab.href}
              aria-current={"current" in tab ? "page" : undefined}
              data-astro-prefetch
            >
              <PixelArt grid={navSprites[tab.key]!} class="terminal-side-nav__icon" />
              {tab.label}
            </a>
          ))
        }
      </nav>

      <div class="terminal-console__content">
        <section id="tooling" class="section terminal-section is-active">
          <div class="section-heading">
            <p class="section-heading__kicker">{kicker}</p>
            <h1>{copy.title}</h1>
            <p class="section-heading__body">{copy.body}</p>
          </div>

          <CardDeck records={toolRecords} locale={locale} />

          <p class="tooling-note">{copy.note}</p>
        </section>
      </div>
    </div>
  </section>

  <script>
    import "../../../scripts/deck.ts";
  </script>
</BaseLayout>
