---
// Tooling for the Simple view (and old links). In the terminal view Tooling is
// a tab of the landing console (index.astro, #tooling), so terminal visitors
// are sent there before first paint, and pulling the lever here does the same.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CardDeck from "../../../components/CardDeck.astro";
import TerminalChassis from "../../../components/TerminalChassis.astro";
import TermPrompt from "../../../components/TermPrompt.astro";
import { toolRecords } from "../../../lib/cards";
import { buildLocalePath, buildLocaleAlternates } from "../../../lib/blog";
import { icon } from "../../../lib/art";
import {
  LOCALES,
  isLocale,
  localeLabels,
  localeSeo,
  navigationCopy,
  toolingCopy,
  type Locale,
} from "../../../lib/i18n";
import "../../../assets/styles/deck.css";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const localeParam = Astro.params.locale;
if (!localeParam || !isLocale(localeParam))
  throw new Error(`Unsupported locale: ${localeParam}`);
const locale: Locale = localeParam;
const copy = toolingCopy[locale];
const seo = localeSeo[locale];
const navigation = navigationCopy[locale];
const home = buildLocalePath(locale);
const kicker = copy.kicker.replace(
  "{count}",
  String(toolRecords.length).padStart(2, "0"),
);
const terminalTab = `${home}#tooling`;
const tabs = [
  { key: "overview", href: `${home}#overview`, label: seo.nav.overview },
  { key: "work", href: `${home}#software-work`, label: seo.nav.work },
  { key: "games", href: `${home}#game-dev`, label: seo.nav.games },
  { key: "experience", href: `${home}#experience`, label: seo.nav.experience },
  {
    key: "tooling",
    href: buildLocalePath(locale, "/tooling"),
    label: navigation.tooling,
    current: true,
  },
  { key: "notes", href: `${home}#blog`, label: seo.nav.blog },
  { key: "contact", href: `${home}#contact`, label: seo.nav.contact },
] as const;
---

<BaseLayout
  locale={locale}
  active="tooling"
  localePathSuffix="/tooling"
  title={navigation.tooling}
  description={copy.body}
  alternates={buildLocaleAlternates("/tooling")}
  bodyClass="has-console"
>
  <script is:inline slot="head" define:vars={{ terminalTab }}>
    if (document.documentElement.dataset.view === "terminal") location.replace(terminalTab);
    window.addEventListener("interface-view-change", (event) => {
      if (event.detail === "terminal") location.assign(terminalTab);
    });
  </script>
  <section
    class="terminal-console section tooling-console"
    data-terminal-lang={localeLabels[locale]}
  >
    <TerminalChassis />
    <div class="terminal-glass">
      <div class="terminal-status" aria-hidden="true">
        <span>Mouchsiadis // field terminal</span>
        <span>LANG {localeLabels[locale]}</span>
        <span>STATION MUC-01</span>
      </div>

      <div class="terminal-console__body">
        <nav class="terminal-side-nav" aria-label={navigation.primaryLabel}>
          {
            tabs.map((tab) => (
              <a
                class:list={["current" in tab && "is-active"]}
                href={tab.href}
                aria-current={"current" in tab ? "page" : undefined}
                data-astro-prefetch
              >
                <img class="terminal-side-nav__icon px-icon" src={icon(tab.key)} alt="" width="32" height="32" />
                {tab.label}
              </a>
            ))
          }
        </nav>

        <div class="terminal-console__content">
          <section id="tooling" class="section terminal-section is-active">
            <TermPrompt cmd="ls --tools" path="~/tooling" />
            <div class="section-heading">
              <p class="section-heading__kicker">{kicker}</p>
              <h1>{copy.title}</h1>
              <p class="section-heading__body">{copy.body}</p>
            </div>

            <CardDeck records={toolRecords} locale={locale} />

            <p class="tooling-note">{copy.note}</p>
          </section>
        </div>
      </div>
    </div>
  </section>

  <script>
    import "../../../scripts/deck.ts";
  </script>
</BaseLayout>
