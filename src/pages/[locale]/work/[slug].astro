---
// Case file: the shareable, full record behind each card. It ends with a
// contextual call to action; the product link stays a secondary action.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { Image, getImage } from "astro:assets";
import ArchDiagram from "../../../components/ArchDiagram.astro";
import CardArt from "../../../components/CardArt.astro";
import TermPrompt from "../../../components/TermPrompt.astro";
import Gallery from "../../../components/Gallery.astro";
import ShotFrame from "../../../components/ShotFrame.astro";
import { partIcons, shotsFor } from "../../../lib/gallery";
import { buildLocalePath } from "../../../lib/blog";
import { EMAIL, mailto } from "../../../lib/contact";
import {
  caseRecords,
  cardOutcome,
  casePath,
  localize,
  transitionName,
} from "../../../lib/cards";
import {
  LOCALES,
  caseCopy,
  deckCopy,
  evidenceLabels,
  isLocale,
  localeSeo,
  type Locale,
} from "../../../lib/i18n";
import "../../../assets/styles/deck.css";

export function getStaticPaths() {
  return LOCALES.flatMap((locale) =>
    caseRecords.map(({ entry }) => ({ params: { locale, slug: entry.slug } })),
  );
}

const { locale: localeParam, slug } = Astro.params;
if (!localeParam || !isLocale(localeParam))
  throw new Error(`Unsupported locale: ${localeParam}`);
const locale: Locale = localeParam;
const index = caseRecords.findIndex(({ entry }) => entry.slug === slug);
if (index < 0) throw new Error(`Unknown case file: ${slug}`);

const { entry, suit } = caseRecords[index]!;
const copy = deckCopy[locale];
const seo = localeSeo[locale];
const labels = evidenceLabels[locale];
const t = <T,>(record: { en: T } & Partial<Record<Locale, T>>) =>
  localize(record, locale);
const home = buildLocalePath(locale);
const back = {
  platform: { href: `${home}#software-work`, label: copy.backToWork },
  tool: {
    href: buildLocalePath(locale, "/tooling"),
    label: copy.backToTooling,
  },
  game: { href: `${home}#game-dev`, label: copy.backToGames },
}[suit];
const prev =
  caseRecords[(index - 1 + caseRecords.length) % caseRecords.length]!.entry;
const next = caseRecords[(index + 1) % caseRecords.length]!.entry;
const alternates = Object.fromEntries(
  LOCALES.map((entryLocale) => [
    entryLocale,
    casePath(entryLocale, entry.slug),
  ]),
) as Record<Locale, string>;
// Role and outcome already lead the header, so the body adds only what it lacks.
const evidence = entry.evidence
  ? [
      { label: labels[1]!, value: t(entry.evidence.contribution) },
      { label: labels[2]!, value: t(entry.evidence.constraints) },
    ]
  : [];
const fileNumber = String(index + 1).padStart(2, "0");
const cc = caseCopy[locale];
const shots = shotsFor(entry.slug);
const heroShot = shots[0];
const moreShots = shots.slice(1);
// Social previews use the hero screenshot when there is one.
const ogImage = heroShot
  ? (await getImage({ src: heroShot.src, format: "png", width: 1200, height: 630, fit: "cover" })).src
  : undefined;
// Facts state the production status; a record's own status label stays in the header.
const statusText =
  suit === "game"
    ? cc.released
    : entry.live
      ? cc.live
      : entry.status
        ? t(entry.status)
        : undefined;
const withTitle = (template: string) =>
  template.replace("{title}", entry.title);
---

<BaseLayout
  locale={locale}
  title={entry.title}
  description={t(entry.summary)}
  alternates={alternates}
  localePathSuffix={`/work/${entry.slug}`}
  image={ogImage}
>
  <article class="case-file" data-suit={suit} data-cover={entry.cover}>
    <a class="case-file__back" href={back.href}>← {back.label}</a>
    <TermPrompt cmd={`cat ${entry.slug}/README.md`} path="~/work" />

    <header class="case-file__header">
      <div
        class="case-file__cover"
        style={`view-transition-name: ${transitionName(entry.slug)};`}
        aria-hidden="true"
      >
        <CardArt slug={entry.slug} cover={entry.cover} eager glint />
      </div>
      <div class="case-file__lead">
        <p class="case-file__kicker">
          <span>{copy.caseKicker} {fileNumber}</span>
          <span aria-hidden="true">//</span>
          <span>{copy.suits[suit]}</span>
          {
            entry.live && (
              <>
                <span aria-hidden="true">//</span>
                <span class="case-file__live">{copy.live}</span>
              </>
            )
          }
          <span class="case-file__cursor" aria-hidden="true">▮</span>
        </p>
        <h1>{entry.title}</h1>
        <p class="case-file__eyebrow">{t(entry.eyebrow)}</p>
        {entry.status && <p class="project-status">{t(entry.status)}</p>}
        <p class="case-file__outcome">{cardOutcome(entry, locale)}</p>
        <div class="case-file__actions">
          {
            entry.link && entry.linkLabel && (
              <a
                class="button"
                href={entry.link}
                target="_blank"
                rel="noopener noreferrer">{t(entry.linkLabel)} ↗</a
              >
            )
          }
          {
            entry.sourceLink && entry.sourceLinkLabel && (
              <a
                class="button button--tertiary"
                href={entry.sourceLink}
                target="_blank"
                rel="noopener noreferrer"
              >
                {t(entry.sourceLinkLabel)} ↗
              </a>
            )
          }
          <a class="button button--tertiary" href="#case-contact"
            >{copy.discuss} ↓</a
          >
        </div>
      </div>
    </header>

    {
      heroShot && (
        <div class="case-file__hero-shot">
          <ShotFrame shot={heroShot} locale={locale} priority={true} />
        </div>
      )
    }

    <section class="case-file__glance" aria-labelledby="case-glance">
      <h2 id="case-glance" class="case-file__section-label">{cc.glance}</h2>
      <dl class="glance">
        {
          entry.evidence && (
            <div>
              <dt>{cc.role}</dt>
              <dd>{t(entry.evidence.role)}</dd>
            </div>
          )
        }
        {
          statusText && (
            <div>
              <dt>{cc.status}</dt>
              <dd>
                {entry.live && <span class="glance__live" aria-hidden="true" />}
                {statusText}
              </dd>
            </div>
          )
        }
        {
          entry.year && (
            <div>
              <dt>{cc.year}</dt>
              <dd>{entry.year}</dd>
            </div>
          )
        }
        <div>
          <dt>{copy.stack}</dt>
          <dd>{entry.stack.slice(0, 5).join(" · ")}</dd>
        </div>
        {
          (entry.link || entry.sourceLink) && (
            <div>
              <dt>{cc.links}</dt>
              <dd class="glance__links">
                {entry.link && (
                  <a href={entry.link} target="_blank" rel="noopener noreferrer">
                    {new URL(entry.link).hostname.replace(/^www\./, "")} ↗
                  </a>
                )}
                {entry.sourceLink && (
                  <a href={entry.sourceLink} target="_blank" rel="noopener noreferrer">
                    {cc.source} ↗
                  </a>
                )}
              </dd>
            </div>
          )
        }
      </dl>
    </section>

    <div class="case-file__body">
      <section aria-labelledby="case-overview">
        <h2 id="case-overview">{cc.overview}</h2>
        <p class="case-file__narrative">{t(entry.narrative)}</p>
      </section>

      {
        entry.evidence && (
          <section aria-labelledby="case-problem">
            <h2 id="case-problem">{cc.problem}</h2>
            <p>{t(entry.evidence.constraints)}</p>
          </section>
        )
      }

      <section aria-labelledby="case-built">
        <h2 id="case-built">{copy.built}</h2>
        {entry.evidence && <p class="case-file__contribution">{t(entry.evidence.contribution)}</p>}
        <ul class="case-file__details">
          {t(entry.details).map((item) => <li>{item}</li>)}
        </ul>
      </section>

      {
        entry.diagram && (
          <section class="case-file__wide" aria-labelledby="case-architecture">
            <h2 id="case-architecture">{cc.architecture}</h2>
            <ArchDiagram name={entry.diagram} locale={locale} />
          </section>
        )
      }

      {
        entry.parts && (
          <section class="case-file__wide" aria-labelledby="case-parts">
            <h2 id="case-parts">{cc.parts}</h2>
            <ul class="parts" role="list">
              {entry.parts.map((part) => (
                <li class="part">
                  {part.icon && partIcons[part.icon] && (
                    <Image class="part__icon" src={partIcons[part.icon]!} alt="" width={96} height={96} loading="lazy" />
                  )}
                  <div class="part__text">
                    <h3>
                      <a href={part.link} target="_blank" rel="noopener noreferrer">
                        {part.title} ↗
                      </a>
                    </h3>
                    {part.version && (
                      <p class="part__version">
                        {cc.version} {part.version}
                      </p>
                    )}
                    <p>{t(part.summary)}</p>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        moreShots.length > 0 && (
          <section class="case-file__wide" aria-labelledby="case-gallery">
            <h2 id="case-gallery">{cc.gallery}</h2>
            <Gallery shots={moreShots} locale={locale} />
          </section>
        )
      }

      <section aria-labelledby="case-stack">
        <h2 id="case-stack">{copy.stack}</h2>
        <ul class="case-file__stack" role="list">
          {entry.stack.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    </div>

    <nav
      class="case-file__adjacent"
      aria-label={`${copy.prevCase} / ${copy.nextCase}`}
    >
      <a href={casePath(locale, prev.slug)} rel="prev"
        ><span>{copy.prevCase}</span><strong>{prev.title}</strong></a
      >
      <a href={casePath(locale, next.slug)} rel="next"
        ><span>{copy.nextCase}</span><strong>{next.title}</strong></a
      >
    </nav>

    <aside
      class="case-file__cta"
      id="case-contact"
      aria-labelledby="case-contact-title"
    >
      <p class="case-file__cta-kicker">{copy.ctaKicker}</p>
      <h2 id="case-contact-title">{copy.ctaTitle}</h2>
      <p>{copy.ctaBody}</p>
      <div class="case-file__cta-actions">
        <a
          class="button button--primary"
          href={mailto(withTitle(copy.ctaSubject))}>{withTitle(copy.ctaEmail)}</a
        >
        <a
          class="button"
          href="/cv/Suren_Mouchsiadis_CV.pdf"
          target="_blank"
          rel="noopener noreferrer">{seo.cta.cv}</a
        >
      </div>
      <p class="case-file__cta-address">
        <span data-email-address>{EMAIL}</span>
        <button
          class="contact-panel__copy"
          type="button"
          data-copy-email
          data-copied={seo.labels.copied}
          hidden>{seo.labels.copyAddress}</button
        >
      </p>
    </aside>
  </article>

  <script>
    import "../../../scripts/copy-email.ts";
  </script>
</BaseLayout>
