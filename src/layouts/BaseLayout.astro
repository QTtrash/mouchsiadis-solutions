---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../assets/styles/global.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/noto-sans-georgian/400.css";
import "@fontsource/noto-sans-georgian/600.css";
import "@fontsource/noto-sans-georgian/700.css";
import "@fontsource/noto-serif-georgian/400.css";
import "@fontsource/noto-serif-georgian/700.css";
import { localeIntlCodes, navigationCopy, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  article?: boolean;
  active?: "home" | "blog" | "tooling";
  alternates?: Record<Locale, string>;
  localePathSuffix?: string;
  noindex?: boolean;
  bodyClass?: string;
  image?: string;
}

const {
  locale,
  title,
  description,
  article = false,
  active = "home",
  alternates,
  localePathSuffix = "",
  noindex = false,
  bodyClass = "",
  image,
} = Astro.props;
---

<!doctype html>
<html lang={localeIntlCodes[locale]}>
  <head>
    <BaseHead
      locale={locale}
      title={title}
      description={description}
      article={article}
      alternates={alternates}
      noindex={noindex}
      image={image}
    />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">{navigationCopy[locale].skipToContent}</a>
    <div class="shell-noise" aria-hidden="true"></div>
    <div class="site-shell">
      <Header
        locale={locale}
        active={active}
        localePathSuffix={localePathSuffix}
      />
      <main class="site-main" id="main-content">
        <slot />
      </main>
      <Footer locale={locale} />
    </div>
  </body>
</html>
