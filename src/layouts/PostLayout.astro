---
import BaseLayout from "./BaseLayout.astro";
import { buildLocalePath, getPostLanguage, getPostSlug } from "../lib/blog";
import { localeIntlCodes, localeSeo, type Locale } from "../lib/i18n";
import { EMAIL, mailto } from "../lib/contact";
import type { CollectionEntry } from "astro:content";

interface Props {
  locale: Locale;
  post: CollectionEntry<"blog">;
  formattedDate: string;
  languageLabel: string;
  prevPost?: CollectionEntry<"blog"> | null;
  nextPost?: CollectionEntry<"blog"> | null;
  alternates?: Record<Locale, string>;
}

const {
  locale,
  post,
  formattedDate,
  languageLabel,
  prevPost,
  nextPost,
  alternates,
} = Astro.props;
const copy = localeSeo[locale];
const { title, description } = post.data;
const postLanguage = localeIntlCodes[getPostLanguage(post)];
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  article={true}
  active="blog"
  alternates={alternates}
  localePathSuffix="/blog"
>
  <section class="section article-shell">
    <div class="section-heading">
      <p class="section-heading__kicker">{copy.sections.blog}</p>
      <h1 lang={postLanguage}>{title}</h1>
      <p class="section-heading__body" lang={postLanguage}>{description}</p>
      <div class="article-shell__meta">
        <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
        <span>{copy.labels.blogLanguage}: {languageLabel}</span>
      </div>
    </div>

    <article class="article-prose" lang={postLanguage}>
      <slot />
    </article>

    <div class="article-shell__nav">
      <a href={buildLocalePath(locale, "/blog")}>← {copy.labels.blogBack}</a>
      <div class="article-shell__adjacent">
        {
          prevPost && (
            <a
              href={buildLocalePath(
                getPostLanguage(prevPost),
                `/blog/${getPostSlug(prevPost)}`,
              )}
            >
              {copy.labels.prevPost}: <span lang={localeIntlCodes[getPostLanguage(prevPost)]}>{prevPost.data.title}</span>
            </a>
          )
        }
        {
          nextPost && (
            <a
              href={buildLocalePath(
                getPostLanguage(nextPost),
                `/blog/${getPostSlug(nextPost)}`,
              )}
            >
              {copy.labels.nextPost}: <span lang={localeIntlCodes[getPostLanguage(nextPost)]}>{nextPost.data.title}</span>
            </a>
          )
        }
      </div>
    </div>

    <p class="article-shell__contact">
      {copy.labels.articleContact}
      <a href={mailto(copy.labels.mailSubject)}>{EMAIL}</a>
    </p>
  </section>
</BaseLayout>
